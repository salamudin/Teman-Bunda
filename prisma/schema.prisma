generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String         @id @default(cuid())
  name           String
  email          String         @unique
  password       String
  phone          String?
  age            Int?
  status         String         @default("PROGRAM_HAMIL")
  gestationalAge Int?
  dueDate        DateTime?
  avatar         String?
  role           String         @default("USER")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  hpht           DateTime?
  bookings       Booking[]
  notifications  Notification[]
}

model Bidan {
  id              String         @id @default(cuid())
  name            String
  email           String         @unique
  password        String
  phone           String?
  avatar          String?
  experience      String
  bio             String?
  specializations String
  rating          Float          @default(0)
  totalReviews    Int            @default(0)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  harga           Int            @default(150000)
  availabilities  Availability[]
  bookings        Booking[]
}

model Availability {
  id        String   @id @default(cuid())
  bidanId   String
  date      DateTime
  startTime String
  endTime   String
  isBooked  Boolean  @default(false)
  createdAt DateTime @default(now())
  bidan     Bidan    @relation(fields: [bidanId], references: [id])
  booking   Booking?

  @@index([bidanId, date])
  @@index([bidanId, isBooked, date])
}

model Booking {
  id             String         @id @default(cuid())
  userId         String
  bidanId        String
  availabilityId String         @unique
  notes          String?
  status         String         @default("WAITING_PAYMENT")
  amount         Int            @default(150000)
  paymentProof   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  grossAmount    Int?
  paymentToken   String?
  availability   Availability   @relation(fields: [availabilityId], references: [id])
  bidan          Bidan          @relation(fields: [bidanId], references: [id])
  user           User           @relation(fields: [userId], references: [id])
  messages       Message[]
  notifications  Notification[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([bidanId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model Message {
  id         String   @id @default(cuid())
  bookingId  String
  senderId   String
  senderType String
  senderName String
  content    String?
  createdAt  DateTime @default(now())
  imageUrl   String?
  type       String   @default("TEXT")
  booking    Booking  @relation(fields: [bookingId], references: [id])

  @@index([bookingId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  bookingId String?
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  booking   Booking? @relation(fields: [bookingId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([bookingId])
}

model Testimonial {
  id          String   @id @default(cuid())
  userId      String?
  name        String
  text        String
  category    String
  isAnonymous Boolean  @default(false)
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  rating      Int      @default(5)
}
